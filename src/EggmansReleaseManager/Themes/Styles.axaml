<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
  </Style>

  <Style Selector="TextBlock.dim"><Setter Property="Foreground" Value="{DynamicResource DimBrush}" /></Style>
  <Style Selector="TextBlock.accent"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="TextBlock.accent2"><Setter Property="Foreground" Value="{DynamicResource Accent2Brush}" /></Style>
  <Style Selector="TextBlock.hi"><Setter Property="Foreground" Value="{DynamicResource HiBrush}" /></Style>
  <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{DynamicResource OkBrush}" /></Style>
  <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}" /></Style>
  <Style Selector="TextBlock.err"><Setter Property="Foreground" Value="{DynamicResource ErrBrush}" /></Style>
  <Style Selector="TextBlock.frame"><Setter Property="Foreground" Value="{DynamicResource FrameHiBrush}" /></Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Hard blink (on/off, no fade) like ANSI ESC[5m -->
  <Style Selector=":is(Control).blink">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="55%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="56%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="CaretBrush" Value="{DynamicResource HiBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SelBgBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelFgBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
  </Style>

  <Style Selector="Menu">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Padding" Value="10,3" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource FrameBrush}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource FrameBrush}" />
  </Style>

  <!-- Title-bar caption buttons -->
  <Style Selector="Button.caption">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinWidth" Value="34" />
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource ErrBrush}" />
  </Style>

  <!-- Must stay last: text inside a selected row uses the selection colour, whatever its class. -->
  <Style Selector="ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SelFgBrush}" />
  </Style>
</Styles>
