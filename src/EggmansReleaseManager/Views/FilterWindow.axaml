<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EggmansReleaseManager.ViewModels"
        xmlns:ui="using:EggmansReleaseManager.UI"
        x:Class="EggmansReleaseManager.Views.FilterWindow"
        x:DataType="vm:FilterEditorViewModel"
        Title="Filter Control"
        Width="1180" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">
  <Border BorderBrush="{DynamicResource FrameHiBrush}" BorderThickness="1">
    <DockPanel>
      <!-- title -->
      <Border DockPanel.Dock="Top" Name="TitleDrag" Background="{DynamicResource SelBgBrush}" Padding="10,4">
        <TextBlock Foreground="{DynamicResource SelFgBrush}" FontWeight="Bold"
                   Text="▓▒░ FiLTER CONTROL :: choose which release assets get leeched ░▒▓" />
      </Border>

      <!-- buttons -->
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="14,6,14,12">
        <TextBlock Classes="dim" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="After saving you'll be asked whether to clean up files already in your archive that match the skip rules." />
        <Button Grid.Column="1" Classes="hot" Content="SAVE RULES" Click="OnSave" Margin="0,0,8,0" MinWidth="120" />
        <Button Grid.Column="2" Content="CANCEL" Click="OnCancel" MinWidth="100" />
      </Grid>

      <Grid ColumnDefinitions="300,*" Margin="14,4,14,0">
        <!-- scopes -->
        <HeaderedContentControl Grid.Column="0" Theme="{StaticResource RetroPanel}" Header="SCOPE" Padding="4,10,4,4">
          <ListBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterScope">
                <TextBlock TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Glyph}" Foreground="{DynamicResource Accent2Brush}" />
                  <Run Text=" " />
                  <Run Text="{Binding Display}" />
                </TextBlock>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </HeaderedContentControl>

        <!-- editor -->
        <Grid Grid.Column="1" Margin="12,0,0,0" RowDefinitions="Auto,Auto,*">
          <HeaderedContentControl Grid.Row="0" Theme="{StaticResource RetroPanel}" Header="{Binding ScopeTitle}">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="24" IsVisible="{Binding IsRepoScope}">
                <CheckBox Content="custom rules for this repo" IsChecked="{Binding HasCustomRule}" />
                <CheckBox Content="also apply GLOBAL rules" IsChecked="{Binding UseGlobal}" IsEnabled="{Binding HasCustomRule}" />
              </StackPanel>
              <TextBlock IsVisible="{Binding IsRepoScope}" Classes="accent2" TextWrapping="Wrap" Text="{Binding InheritedSummary}" />
              <TextBlock IsVisible="{Binding IsRepoScope}" Classes="dim" TextWrapping="Wrap"
                         Text="Without custom rules a repo just follows the GLOBAL rules. Untick 'also apply GLOBAL' to give a repo its own rules only (e.g. keep linux builds for one repo)." />

              <StackPanel Spacing="8" IsEnabled="{Binding EditorEnabled}">
                <TextBlock Classes="accent" Text="SKiP ASSETS DETECTED AS ── (detected from the filename; GitHub has no platform field)" />
                <ItemsControl ItemsSource="{Binding Platforms}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlatformToggle">
                      <CheckBox Width="200" Margin="0,2" IsChecked="{Binding Excluded}" ToolTip.Tip="{Binding Hint}">
                        <TextBlock>
                          <Run Text="{Binding Label}" />
                          <Run Text="{Binding Group}" Foreground="{DynamicResource DimBrush}" FontSize="10" />
                        </TextBlock>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="OS/ARCH: skipped only when ALL of its detected OS (or arch) tags are ticked, so 'app-win-linux.zip' survives a LiNUX skip. KiND (source/checksums/debug): skipped if any matches. Untagged files count as universal and are kept." />

                <Grid ColumnDefinitions="*,12,*">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="accent" Text="SKiP PATTERNS (one per line)" />
                    <TextBox Text="{Binding ExcludePatternsText}" AcceptsReturn="True" Height="96" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                             Watermark="e.g.&#x0a;*-linux-*&#x0a;re:-pgo\.(zip|tar\.gz)$" />
                    <WrapPanel>
                      <TextBlock Classes="dim" Text="quick add: " VerticalAlignment="Center" />
                      <Button Classes="flat" Content="*-linux-*" Command="{Binding AddPatternCommand}" CommandParameter="*-linux-*" />
                      <Button Classes="flat" Content="*-macos-*" Command="{Binding AddPatternCommand}" CommandParameter="*-macos-*" />
                      <Button Classes="flat" Content="*.zsync" Command="{Binding AddPatternCommand}" CommandParameter="*.zsync" />
                      <Button Classes="flat" Content="*-pgo*" Command="{Binding AddPatternCommand}" CommandParameter="*-pgo*" />
                    </WrapPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Classes="accent" Text="ALWAYS GET (beats every skip rule)" />
                    <TextBox Text="{Binding IncludePatternsText}" AcceptsReturn="True" Height="96" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                             Watermark="e.g.&#x0a;*-windows-*" />
                    <TextBlock Classes="dim" TextWrapping="Wrap"
                               Text="* = anything, ? = one char. No wildcard = 'contains'. Prefix re: for a regex. Case-insensitive." />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding PatternWarning}" Classes="err" TextWrapping="Wrap" IsVisible="{Binding PatternWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Grid.Row="1" Theme="{StaticResource RetroPanel}" Header="TEST A FiLENAME" Margin="0,4,0,0">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
              <TextBlock Text="FiLE ► " Classes="label" />
              <TextBox Grid.Column="1" Text="{Binding TestFileName}" />
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Text="{Binding TestResult}"
                         Classes="err" Classes.ok="{Binding TestKeep}" />
            </Grid>
          </HeaderedContentControl>

          <HeaderedContentControl Grid.Row="2" Theme="{StaticResource RetroPanel}" Header="LiVE PREViEW" Margin="0,4,0,0" Padding="6,10,6,4">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                <Button Classes="hot" Content="[ PREViEW ]" Command="{Binding RunPreviewCommand}" IsEnabled="{Binding !IsPreviewing}" />
                <TextBlock Grid.Column="1" Text="{Binding PreviewStatus}" Classes="dim" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Classes.blink="{Binding IsPreviewing}" />
              </Grid>
              <ListBox ItemsSource="{Binding Preview}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PreviewRow">
                    <Grid ColumnDefinitions="48,150,*,80,150,200">
                      <TextBlock Grid.Column="0" Text="{Binding Verdict}" FontWeight="Bold" Classes="ok" Classes.err="{Binding Skip}" />
                      <TextBlock Grid.Column="1" Text="{Binding Tag}" Classes="dim" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="2" Text="{Binding Name}" Classes="hi" Classes.dim="{Binding Skip}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding Size}" TextAlignment="Right" Margin="0,0,10,0" />
                      <TextBlock Grid.Column="4" Text="{Binding Platforms}" Classes="accent" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="5" Text="{Binding Reason}" Classes="accent2" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </HeaderedContentControl>
        </Grid>
      </Grid>
    </DockPanel>
  </Border>
</Window>
